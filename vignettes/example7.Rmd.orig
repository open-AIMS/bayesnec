r_salina,B3,ErC50,1.008,1.000,1.016,TRUE
r_salina,C,ErC50,1.004,0.996,1.012,TRUE
r_salina,D,ErC50,0.995,0.995,0.995,FALSE
r_salina2,A,ErC50,1.000,0.903,1.112,TRUE
