               arrow = arrow(length = unit(0.08, "inches"), type = "closed"),
               linewidth = 0.7) +
  geom_point(aes(x = bias_s), size = 1.7) +
  facet_grid(estimate ~ cell, scales = "free_x") +
  scale_colour_manual(values = arm_cols, guide = "none") +
  labs(x = "Relative bias (%)", y = "Approach") +
