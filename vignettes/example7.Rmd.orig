cases$arm <- factor(cases$arm, levels = arm_levels)
cases$estimate <- factor(cases$estimate, levels = c("ErC10", "ErC50", "NSEC"))
cases$dataset <- factor(cases$dataset,
  levels = c("c_proliferum", "c_proliferum2", "r_salina", "r_salina2"))

# Expressed as a ratio to the `measured` analysis on the same dataset, because
# the four tests are on undisclosed and mutually incomparable concentration
# scales. An estimate is flagged unusable where it could not be identified, or
# where its interval reached an edge of the tested range -- there the bound is
# the design rather than the data -- or collapsed to a point.
case_ratios <- cases |>
  group_by(dataset, estimate) |>
  mutate(ref = value[arm == "measured"],
         r = value / ref, rlo = lower / ref, rhi = upper / ref,
         usable = !is.na(r) & !is.na(rlo) & !is.na(rhi) &
                  !(lower <= x_min | upper >= x_max |
                      upper - lower < .Machine$double.eps^0.5)) |>
  ungroup()

rr <- function(ds, a, est = "ErC50", what = "r") {
  case_ratios[[what]][case_ratios$dataset == ds & case_ratios$arm == a &
                        case_ratios$estimate == est]
}
others <- setdiff(arm_levels, "measured")
# Written with an explicit function rather than sapply(others, rr, ds, est):
# sapply passes the element as the FIRST argument, so that form silently swaps
# the convention and the dataset and every lookup returns nothing.
each_other <- function(ds, est) {
  vapply(others, function(a) {
    v <- rr(ds, a, est)
    if (length(v) == 1L) v else NA_real_
  }, numeric(1))
}
rng_ratio <- function(ds, est = "ErC50") range(each_other(ds, est), na.rm = TRUE)
furthest <- function(ds, est = "ErC50") {
  v <- each_other(ds, est)
  v <- v[is.finite(v) & v > 0]
  if (!length(v)) return(NA_real_)
  unname(v[which.max(abs(log(v)))])
}
zw <- function(ds, a) unique(cases$w_zero_asymptote[cases$dataset == ds &
                                                      cases$arm == a])
# Written as a computed phrase rather than a bare count: "0 of 72" reads badly
# and a number typed into the prose goes stale the next time the study is run.
unusable_note <- function() {
  n <- sum(!case_ratios$usable)
  if (n == 0) {
    paste("No estimate in Figure 7 is flagged unusable: every interval lies",
          "inside the tested concentration range.")
  } else {
    sprintf(paste("%d of the %d estimates in Figure 7 are flagged unusable,",
                  "their intervals having reached an edge of the tested",
                  "concentration range or collapsed to a point."),
            n, nrow(case_ratios))
  }
}
pc <- function(x) sprintf("%.0f%%", 100 * x)
f2c <- function(x) if (!length(x) || any(is.na(x))) "—" else sprintf("%.2f", x)
```

Because the toxicity values of the four datasets are on completely different
concentration scales, each estimate is shown as a ratio, i.e. the estimate from
a convention divided by the `measured` estimate on that dataset, so that a
ratio of 1 is exact agreement (Figure 7).

```{r real-ratios, fig.width = 9, fig.height = 5.5, out.width = "100%", fig.cap = "**Figure 7.** Estimated ErC10, ErC50 and NSEC from each convention on the four real datasets, expressed as a ratio to the `measured` analysis of the same dataset, with 95% credible intervals. The vertical line at 1 is exact agreement. Open symbols mark estimates flagged as unusable, meaning the interval reached an edge of the tested concentration range, where the bound is the design rather than the data, or collapsed to a point. Intervals extending past the plotted range are clipped at the panel edge."}
# Clipping by pmax/pmin on the data rather than a scale limit, to avoid
# depending on `scales` for an out-of-bounds handler. An interval that runs past
# the panel is already flagged unusable and is drawn with an open symbol.
ratio_lim <- c(0.1, 4)
case_ratios$rlo_p <- pmax(case_ratios$rlo, ratio_lim[1])
case_ratios$rhi_p <- pmin(case_ratios$rhi, ratio_lim[2])

ggplot(case_ratios, aes(x = r, y = arm, colour = arm, shape = usable)) +
  geom_vline(xintercept = 1, linetype = "dashed", colour = "grey40") +
  geom_errorbar(aes(xmin = rlo_p, xmax = rhi_p), orientation = "y",
                width = 0, linewidth = 0.6) +
  geom_point(size = 2.2, fill = "white") +
  scale_shape_manual(values = c("TRUE" = 16, "FALSE" = 21), guide = "none") +
  scale_y_discrete(limits = rev(arm_levels)) +
  scale_x_log10(breaks = c(0.25, 0.5, 1, 2, 4), limits = ratio_lim) +
  facet_grid(estimate ~ dataset) +
  labs(x = "Estimate as a ratio to the `measured` analysis (log scale)",
       y = NULL) +
  scale_colour_manual(values = arm_cols, guide = "none") +
  theme_classic(base_size = 9) +
  theme(strip.background = element_blank(), legend.position = "none")
```

`r unusable_note()`

Three features of Figure 7 require care in what they do and do not establish.

First, the choice of convention changes the reported value substantially on one
of the four datasets, and hardly at all on the other three. On `c_proliferum`
the five conventions other than `measured` return an ErC50 between
`r f2c(rng_ratio("c_proliferum")[1])` and `r f2c(rng_ratio("c_proliferum")[2])`
times the `measured` estimate, which is the difference between one regulatory
value and another. On `c_proliferum2`, `r_salina` and `r_salina2` the estimate
from the convention furthest from `measured` is
`r f2c(furthest("c_proliferum2"))`, `r f2c(furthest("r_salina"))` and
`r f2c(furthest("r_salina2"))` times the `measured` estimate, respectively.

The size of the effect therefore does not appear to be predictable from the
data alone, and
on three of these four datasets a reader choosing between conventions would have
seen almost no difference. However, this is not evidence that the choice is
safe. The simulation is unambiguous about the direction of the error, and about
the fact that the error does not shrink as an experiment becomes more precise.
A single real dataset, by contrast, cannot separate the effect of a convention
from the error of the analysis it is compared against, because the `measured`
analysis has its own error and there is no truth against which to score either
of them.

```{r, echo = FALSE}
knitr::kable(
  cases |>
    filter(estimate == "ErC50") |>
    select(dataset, arm, w_zero_asymptote) |>
    pivot_wider(names_from = dataset, values_from = w_zero_asymptote) |>
    arrange(arm),
  digits = 2,
  col.names = c("Convention", levels(cases$dataset)),
  caption = "**Table 5.** Total model weight on the six equations whose lower asymptote is fixed at zero, for each convention on each dataset."
)
```

Second, the mixing of some of these fits needs to be read alongside the ratios.
Each fit is an average over thirteen or fourteen equations, and on two datasets
a substantial share of the weight is on equations that mixed poorly. For each
fit, the transcribed table records the weight held by equations whose tail
effective sample size fell below 400, which is the level at which the bounds of
a 95% interval are no longer reliably estimated (Table 4).

```{r, echo = FALSE}
knitr::kable(
  cases |>
    filter(estimate == "ErC50", w_failing_ess > 0.01) |>
    select(dataset, arm, w_failing_ess) |>
    arrange(desc(w_failing_ess)),
  digits = 3,
  col.names = c("Dataset", "Convention", "weight on tail ESS < 400"),
  caption = "**Table 4.** Model weight held by equations whose tail effective sample size fell below 400, for the fits where it exceeds 0.01. Fits not listed hold essentially none. In the simulation the largest such figure in any cell and convention is under 0.005."
)
```

This is a limitation of these four fits, and not of the conventions. It affects
`measured` and `deleted` on `r_salina`, which are reference analyses and not the
conventions under test, so the ratios on that dataset should be read as the
weaker evidence. The simulation does not have this problem. Averaged over its
4,200 fits, equations failing either diagnostic account for 0.4% of the model
weight, and the largest figure for any one cell and convention is 5.2% (under
`gamma` in the `ctl` cell), so no figure reported from the simulation depends on
an equation that did not converge.

Third, the weight on the zero-asymptote equations, which Section 5.7 identifies
as a diagnostic for flooring under an unbounded family, can be computed here
because it needs no truth (Table 5). Averaged over the four datasets `floored`
places `r pc(mean(sapply(levels(cases$dataset), zw, "floored")))` of its weight
on these equations, against
`r pc(mean(sapply(levels(cases$dataset), zw, "measured")))` under `measured` and
`r pc(mean(sapply(levels(cases$dataset), zw, "censored")))` under `censored`,
whereas in the simulation the corresponding weights range from near zero to near
one. Two things differ between the simulation and the case studies. In the
simulation the generating equation is in the candidate set and is known to be
correct, so a retaining convention recovers it and a floored one visibly cannot,
whereas on real data no candidate is known to be correct. In addition, these
growth-rate curves appear to decline toward zero whatever is done to the data,
so a
zero-asymptote shape is a defensible description of all four datasets, and not
an artefact of one convention. The case studies therefore establish that the
choice of convention changes the reported value, but they do not confirm the
mechanism, and without a known truth they cannot.

# 7 Recommendations

We recommend analysing the growth rates as measured, and letting the model set
determine the shape of the curve, because nothing in a Gaussian
concentration-response fit requires the response to be positive. In the
simulation this approach recovers the true ErC50 to within
`r f1(max(abs(sapply(c("p1","p2","p3","p4"), function(cl) val("measured","ErC50",cl)))))`%
at each level of measurement precision tested, maintains nominal interval
coverage, and gives the generating equation
`r f2(weights$w_nec4param[weights$cell == "p4" & weights$arm == "measured"])`
of the model weight at the highest precision tested.

Where the negative values were never recorded, we recommend declaring them
censored instead of substituting a value. At the highest precision tested,
`censored` matches the measurements themselves on ErC50
(`r f1(val("censored", "ErC50", "p4"))`% against
`r f1(val("measured", "ErC50", "p4"))`%), and it is the only option when the
underlying values are gone. Together with `deleted`, it is also one of only two
conventions that maintain nominal coverage for all three toxicity estimates
across the whole precision sweep.

Deleting the negative rows is better than replacing them, but worse than keeping
them. The ErC50 bias of `deleted` converges on zero as the experiment becomes
more precise, and its coverage remains nominal. However, deletion changes the
replication per concentration, and at the top of a series it may remove a
treatment group altogether, which is a change to the design and not to the
data.

We do not recommend replacing negative values with zero. Flooring results in an
ErC50 bias of `r f1(val("floored", "ErC50", "p4"))`% that does not shrink as
the experiment becomes more precise, so its interval coverage falls to
`r f2(val("floored", "ErC50", "p4", "coverage"))` at the highest precision
tested, and it displaces the NSEC by `r f1(val("floored", "NSEC", "p4"))`%.
Averaging over the candidate set absorbs part of this distortion (the ErC10 of
`floored` is close to unbiased), but it does not remove it, and it cannot do
so, because the floored data are no longer draws from the process that produced
the measurements.

We also do not recommend choosing a zero-bounded response distribution (e.g. a
Beta or a Gamma) as a way of dealing with negative values. Although this appears
to be the most common response to negative growth rates, it does not work. The
Beta maintains an ErC50 bias near
`r f1(val("beta", "ErC50", "p4"))`% at each precision, and an ErC10 bias that
increases to `r f1(val("beta", "ErC10", "p4"))`% as the experiment becomes more
precise, while the Gamma converges on ErC50 but displaces ErC10 by
`r f1(val("gamma", "ErC10", "p4"))`%, with coverage of
`r f2(val("gamma", "ErC10", "p4", "coverage"))`. Both conventions give no
outward sign of a problem, as all 1,400 fits under these two conventions
converged and returned all three toxicity estimates.

Converting the response to percent inhibition before fitting is also not
recommended. Expressing the response as a percentage of the control caps it at
100%, which makes negative growth look like an error and may encourage the
analyst to choose a bounded family. In addition, `ecx(type = "absolute")` already
expresses the effect relative to the fitted control, so the transformation is
unnecessary as well as harmful, and @Ritz2026 reach this conclusion by a
different route. `bayesnec` will warn if it detects data that appear to have
been normalised.

We recommend reporting the proportion of observations at or below zero, because
it is the single number that indicates whether the question arises for a
dataset at all.
In the `ctl` cell, where about two observations in seventy are negative, the
four Gaussian conventions span `r f1(spread("ErC50", "ctl"))` percentage points
of ErC50 bias between them, whereas at one in seven, with equal control
variability, they span `r f1(spread("ErC50", "p1"))`.

Interval coverage and interval width should not be reported on their own. At the
highest precision tested, `gamma` achieves nominal coverage on ErC50 with
intervals
`r f2(val("gamma", "ErC50", "p4", "width") / val("measured", "ErC50", "p4", "width"))`
times as wide as those of `measured`, while `floored` has narrower intervals
than `gamma` and contains the truth in a quarter of the realisations. Either
figure on its own would therefore reverse the ranking of these two conventions.

Finally, the model weights should be read as a description of the data
supplied. On floored data the generating equation receives essentially none of
the weight, and a zero-asymptote shape receives almost all of it, with a
confidence that increases as the experiment becomes more precise. A weight is
evidence about which shape fits the data supplied to the model, and not about
which process produced the measurements.

# 8 Limitations

The data are generated from a single equation (`nec4param`), which is in the
candidate set of each Gaussian convention, so the study measures how well each
convention allows a correctly specified candidate to be recovered. It does not
establish what happens when no candidate is correct, which is typically
the situation with real data.

The residual scale is constant along the curve, and each fit is homoscedastic
to match. This is a deliberate simplification, made so that no convention is
misspecified in its variance, but it means that none of the conventions
reported here estimates a dispersion that varies along the curve. One of the
four `alga` datasets does show a residual gradient (Section 5.2), so the
homoscedastic case is not the only one that arises.

We also ran the precision sweep with a dispersion sub-model, on the cells and
realisations used above, but do not report those results. A sub-model does not
repair the conventions that impose the zero boundary through the response
distribution, and adding one to a Gaussian family, whose variance model is
already correct, gives its variance a gradient the data do not have. The code
and the tables are in the compendium, and its `CLAUDE.md` records why they are
not cited.

The priors are the defaults of `bnec()`, derived once per cell and convention
from a reference realisation and then held fixed across the 100 realisations of
that cell, so that the Stan programs are identical between realisations and
compile only once. Holding the priors fixed eliminates the variation in the prior
from one realisation to the next, which is nuisance variation. Each convention
still has its own prior derived from its own prepared data, so the contrast
between conventions is unaffected. Under the pinned version of `bayesnec` the
default `nec` prior is a lognormal on the log of the predictor, with a central
95% interval that spans the concentrations tested. This prior
places the true `nec` of 1.3 between the 23rd and the 63rd percentile, depending
on the cell, and the true ErC50 between the 80th and the 95th, so both are
comfortably inside it.

This was not the case in the version of this study published before, in which
the default `nec` and `ec50` prior was a gamma whose spread is tied to its
shape. Its central 95% interval therefore covered a fraction of a
logarithmically spaced series, however the series was designed, and it placed
the true ErC50 above the 99th percentile in each cell. Anyone comparing both
versions should therefore be aware that the equations parameterised by `ec50`
are likely to behave differently between them for that reason alone.

Each cell was simulated 100 times, and the Monte Carlo standard error of the
reported bias has a median of
`r f1(median(sim$mcse_pct[sim$estimate == "ErC50"]))`% of the true value for
ErC50, `r f1(median(sim$mcse_pct[sim$estimate == "ErC10"]))`% for ErC10 and
`r f1(median(sim$mcse_pct[sim$estimate == "NSEC"]))`% for the NSEC, with a
maximum of `r f1(max(sim$mcse_pct))`% for the
`r sim$arm[which.max(sim$mcse_pct)]` NSEC in the
`r sim$cell[which.max(sim$mcse_pct)]` cell. Differences smaller than these are
not resolved by this study. The Monte Carlo standard error on a coverage of 0.95
is `r f2(sqrt(0.95 * 0.05 / 100))`.

The design is fixed at seventy observations across twelve concentrations
spanning a factor of one hundred, with ten controls. The study therefore does
not establish how the conventions behave on a smaller design, on an arithmetic
series, or, beyond the single `ctl` cell, on a series that does not reach the
zero crossing at all.

The case studies compare the conventions on four datasets whose truth is
unknown. They show that the choice of convention changes the reported value,
and the results that they do not reproduce from the simulation are described in
Section 6.2. However, they are not recommendations for how those particular
tests should be analysed, and the *Rhodomonas* comparison is weaker than the
*Cladocopium* comparison, because no convention there is a true analysis of the
measurements (Section 6.1).

# 9 Provenance of the reported results

Neither the simulation nor the case studies are run when this vignette is built.
Together they comprise 4,224 model-averaged fits, which is far more machine time
than a package build can use, and they are run instead in a separate research
compendium,
[open-AIMS/negative-response-conventions](https://github.com/open-AIMS/negative-response-conventions)
[@negresponse2026]. The compendium contains the generating code, the runners,
the fixed priors (as tracked files), the container in which the fits ran, and
the result tables from which all figures here are transcribed.

All figures quoted are transcribed from the output of the compendium at the
commit named in its bibliography entry, i.e. `results/metrics.csv` for the
simulation, `results/weights.csv` for the model weights of Table 2, and
`results/case_estimates.csv` for Section 6. The fits were run against `bayesnec`
at commit `9269bf6d`, as recorded in the compendium's `hpc/bayesnec.lock`,
inside the container identified by the compendium's `hpc/image.lock`, which
provides the toolchain and installs the package from that pinned source.

This commit is a development version of `bayesnec`, and not a release. The
version is more important here than usual, because this vignette measures the
behaviour of the package defaults. The results reported above depend on three
defaults at that commit: the `nec` and `ec50` priors are built on the log of the
predictor, the initial-value search accepts chains individually, and the NSEC
crossing is sought from the control upward, with the control as the first point
of the searched grid. The NSEC search was revised after that commit in ways that
may change NSEC estimates and their intervals (see `NEWS.md`), so an analysis
run under a later version of `bayesnec` may not reproduce these numbers exactly.

The posterior predictive figures quoted in Section 5.4 are transcribed from
`results/ppc_spread.csv`, which summarises 100 realisations of each cell and
convention, and cover only the four precision cells. The study also keeps one
fitted object per cell and convention, and all 24 case fits, chosen by a seed
fixed on the cell and convention names before any result was seen. These fits
are not in the compendium's repository (66 model-averaged fits is too much to
track), and are instead fetched from the cluster with `hpc/fetch-fits.sh`.

The case studies are also fitted in the compendium. Four datasets by six
conventions, each an average over thirteen or fourteen equations, take about
fifteen hours, which is too long to run on a workstation whenever the vignette
is built. The case-study estimates therefore describe the pinned commit, as the
simulation does, and not the version of `bayesnec` installed with this vignette.
However, Table 3, which describes the four datasets themselves, is computed at
build time from the `alga` data that ship with the package, and therefore does
reflect your installation.

