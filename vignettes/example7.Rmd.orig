sim$handling <- factor(arm_handling[sim$arm], levels = handling_levels)
sim$arm <- factor(sim$arm, levels = arm_levels)
sim$estimate <- factor(sim$estimate, levels = c("ErC10", "ErC50", "NSEC"))

sim <- left_join(sim, cells[, c("cell", "cv_control", "delta", "top_factor")],
                 by = "cell")
# The precision sweep and the design cells are different comparisons and are
# never plotted on one axis: p1 to p4 share an estimand and differ in noise,
# while d2, d8 and ctl change the truth or the design.
precision <- subset(sim, cell %in% c("p1", "p2", "p3", "p4"))
# CV as an ordered factor rather than a numeric axis: the four levels are not
# evenly spaced on either a linear or a log scale, and what matters is their
# order, not their spacing.
precision$cv_f <- factor(sprintf("%.1f", 100 * precision$cv_control),
                         levels = c("9.6", "6.7", "2.8", "1.9"))
design_cells <- subset(sim, cell %in% c("d2", "d8", "ctl"))
design_cells$cell <- factor(
  design_cells$cell, levels = c("d2", "d8", "ctl"),
  labels = c("d2 (shallow)", "d8 (deep)", "ctl (few negatives)"))

# Read a figure out of the table rather than typing it into the prose, so that a
# re-run of the study cannot leave the text describing an earlier one.
val <- function(a, est, cl, what = "rel_bias") {
  sim[[what]][sim$arm == a & sim$estimate == est & sim$cell == cl]
}
# a bias of -0.04 rounds to "-0.0", which reads as a sign rather than a value
f1 <- function(x) sub("^-0\\.0$", "0.0", sprintf("%.1f", x))
# How far apart the four Gaussian conventions are in one cell, in percentage
# points. This is the quantity a reader deciding whether the choice matters
# needs; the largest single bias is a different number and would overstate the
# disagreement.
gaussian_arms <- c("measured", "censored", "deleted", "floored")
spread <- function(est, cl) {
  v <- sapply(gaussian_arms, val, est, cl)
  max(v) - min(v)
}
f2 <- function(x) sprintf("%.2f", x)
```

