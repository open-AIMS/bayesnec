arm_cols <- c(measured = "#1B5FAE", censored = "#C25E12", deleted = "#1F9E8C",
              floored = "#B0217A", beta = "#7C7A00", gamma = "#8E44C9")
arm_levels <- names(arm_cols)

# The facet variable in every figure. The distinction that matters is not
# four-versus-two but how the zero boundary comes to be imposed: not at all, by
# substituting or removing data, or implicitly as a side effect of choosing a
# response distribution.
arm_handling <- c(measured = "Measurement retained",
                  censored = "Measurement retained",
                  deleted = "Measurement retained",
                  floored = "Zero boundary imposed",
                  beta = "Zero bounded by the family",
                  gamma = "Zero bounded by the family")
