```{r helpers, include = FALSE}
# Formats a number to two significant figures, keeping trailing zeros.
fmt <- function(x, digits = 2) {
  sub("\\.$", "", formatC(signif(x, digits), digits = digits, format = "fg",
                           flag = "#"))
}
# Formats an estimate and its interval for the text and the tables.
ci <- function(v) {
  v <- fmt(unname(unlist(v))[1:3])
  paste0(v[1], " (", v[2], "--", v[3], ")")
}
# Formats the range of a set of values, or one value where they agree.
range_text <- function(x) {
  r <- unique(fmt(range(x)))
  paste(r, collapse = " to ")
}
# Formats names as code, singly or as a list for the text.
eq <- function(x) paste0("`", x, "`")
eqs <- function(x) {
  x <- eq(x)
  if (length(x) < 2) return(x)
  paste(paste(x[-length(x)], collapse = ", "), "and", x[length(x)])
}
# The model weights of a screened set, named by equation.
set_weights <- function(x) {
  stats::setNames(x$mod_stats[x$success_models, "wi"], x$success_models)
}
```

[e1]: https://open-aims.github.io/bayesnec/articles/example1.html
[e2]: https://open-aims.github.io/bayesnec/articles/example2.html
